# ===== Foundry =====
out/
cache/
broadcast/
# Keep deployment artifacts (addresses) but not the full broadcast logs:
# - re-include specific files via `!` if needed.

# ===== Solidity / contracts dependencies =====
# Foundry installs deps under /lib at the repo root. Anchor with leading
# slash so we DON'T accidentally ignore dashboard/src/lib/ (which holds the
# real frontend library code).
/lib/

# ===== Node / pnpm =====
node_modules/
dist/
.next/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

# ===== Env / secrets — NEVER commit =====
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ===== Editors / OS =====
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*~

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===== Skill source clones (when present) =====
/tmp/skill-sources/

# ===== Relayer runtime artifacts =====
relayer/data/
relayer/drizzle/

# ===== Skills.sh agent aliases =====
# .kiro/skills/ is the canonical location and is committed.
# .agents/skills/ is a per-agent copy created by `npx skills add --copy`.
# It can be reproduced any time via `npx skills experimental_sync`.
.agents/skills/

# ===== Generated artifacts kept under version control =====
# (whitelist below if needed)
# !deployments/*.json

# Ponder runtime state (embedded pglite db, build cache)
indexer/.ponder/
indexer/.next-env.d.ts

# Python venv for the bug-hunt playwright runner
.venv-pw/
.venv/
__pycache__/
.aidesigner/*
!.aidesigner/.gitkeep

# Internal AI-agent tooling (kept local, never committed)
.aidesigner/
.claude/
.impeccable/
.kiro/
.mcp.json
skills-lock.json
AGENTS.md
progress.md
memory.md
final-dapp.md
