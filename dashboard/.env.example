# Conduit dashboard env template.

# Privy app id — get free at https://dashboard.privy.io. Public-by-design.
NEXT_PUBLIC_PRIVY_APP_ID=

# Indexer GraphQL endpoint (Ponder default port 42069).
NEXT_PUBLIC_PONDER_URL=http://localhost:42069

# RPC endpoints for client-side reads. Arc is public.
NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_SEPOLIA_RPC=

# Phase 2.3 deployment addresses. Override only if redeployed.
NEXT_PUBLIC_BATCH_REGISTRY=0x34705cF46Ddf9f3cE53f5492B6376678BE62F0fc
NEXT_PUBLIC_BATCH_ROUTER=0x6eD720FDF5c28cF8895A8049Fe13AF1384d82d20
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
